{
  "name": "meal-manage-system-v2",
  "version": "0.4.1",
  "private": true,
  "description": "减脂双餐后台管理系统",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node tests/integration/accounts.cjs",
    "test:e2e": "node tests/e2e/run.cjs",
    "test:docker": "python tests/docker/run.py",
    "docs": "node scripts/generate-docs.js",
    "release:package": "python scripts/build_release.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.22.3",
    "mysql2": "^3.11.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
